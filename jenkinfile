pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = 'ravneeth123'
        IMAGE_NAME = 'react-ecommerce-app'
        DOCKERHUB_CREDENTIALS_ID = 'docker'  // Jenkins credential ID
        GIT_CREDENTIALS_ID = 'github'
    }
    options {
        skipStagesAfterUnstable()
    }

    stages {
        stage('Checkout') {
	steps {
        checkout([$class: 'GitSCM',
            branches: [[name: "${env.BRANCH_NAME}"]],
            userRemoteConfigs: [[
                url: 'https://github.com/ravneet12345/devops-build.git',
                credentialsId: 'github'
            ]]
        ])
    }
}


        stage('Build Docker Image') {
            steps {
                script {
                    sh 'chmod +x build.sh'
                    sh 'build.sh'  // Assumes this script builds a Docker image named react-app
                    sh 'docker images'
                }
            }
        }

        stage('Login to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('', DOCKERHUB_CREDENTIALS_ID) {
                        echo "Logged into Docker Hub"
                    }
                }
            }
        }

        stage('Tag & Push Image') {
            steps {
                script {
                    def repo = (params.BRANCH_NAME == 'dev' || params.BRANCH_NAME == 'prod') ? 'react-app-dev' : 'react-app-prod'
                    def imageTag = "${DOCKERHUB_USERNAME}/${repo}:latest"

                    sh "docker tag ${IMAGE_NAME} ${imageTag}"
                    docker.withRegistry('', DOCKERHUB_CREDENTIALS_ID) {
                        sh "docker push ${imageTag}"
                    }
                }
            }
        }

        stage('Trigger Webhook (optional)') {
            when {
                anyOf {
                    branch 'dev'
                    branch 'prod'
                }
            }
            steps {
                script {
                    def webhookUrl = 'http://52.91.58.104:8080/github-webhook/'  // 🔁 Replace with your actual webhook
                    sh """
                        curl -X POST ${webhookUrl} \\
                        -H 'Content-Type: application/json' \\
                        -d '{"status":"success","branch":"${params.BRANCH_NAME}"}'
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }
        failure {
            echo "❌ Pipeline failed."
        }
    }
}
