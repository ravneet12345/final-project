pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = 'ravneeth123'
        IMAGE_NAME = 'react-ecommerce-app'
        DOCKERHUB_CREDENTIALS_ID = 'docker' // Jenkins credential ID for Docker Hub
        GIT_CREDENTIALS_ID = 'github' // Jenkins credential ID for GitHub
        DEV_SERVER = 'ec2-user@54.243.12.90' // Replace with your dev server
        PROD_SERVER = 'ec2-user@54.172.195.154' // Replace with your prod server
    }
    options {
        skipStagesAfterUnstable()
    }

    stages {
        stage('Detect Branch') {
            steps {
                script {
                    // This will give you something like "origin/dev"
                    def rawBranch = env.GIT_BRANCH ?: sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
                    // Extract actual branch name
                    BRANCH = rawBranch.replaceAll(/^origin\\//, '').trim()
                    echo "Building for branch: ${BRANCH}"
                    env.ACTUAL_BRANCH = BRANCH // store for later stages
                }
            }
        }
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "*/${env.ACTUAL_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/ravneet12345/devops-build.git',
                        credentialsId: "${GIT_CREDENTIALS_ID}"
                    ]]
                ])
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'chmod +x build.sh'
                    sh './build.sh'
                    sh 'chmod 400 demo-b15.pem'
                }
            }
        }

        stage('Login & Push to Docker Hub') {
            steps {
                script {
                    def repoName = (env.BRANCH_NAME == 'prod') ? 'react-app-prod' : 'react-app-dev'
                    def imageTag = "${DOCKERHUB_USERNAME}/${repoName}:latest"

                    sh "docker tag ${IMAGE_NAME} ${imageTag}"
                    docker.withRegistry('', DOCKERHUB_CREDENTIALS_ID) {
                        sh "docker push ${imageTag}"
                    }

                    env.IMAGE_TAG = imageTag // Save for deploy
                }
            }
        }

        stage('Deploy to Server') {
            steps {
                script {
                    def repo = (params.BRANCH_NAME == 'prod') ? 'react-app-prod' : 'react-app-dev'
                    def imageTag = "${DOCKERHUB_USERNAME}/${repo}:latest"
                    def targetServer = (params.BRANCH_NAME == 'prod') ? PROD_SERVER : DEV_SERVER

                    sh """
                        ssh -i demo-b15.pem -o StrictHostKeyChecking=no ${targetServer} '
                            docker pull ${imageTag} &&
                            docker stop ${repo} || true &&
                            docker rm ${repo} || true &&
                            docker run -d --name ${repo} -p 80:80 ${imageTag}
                        '
                    """
                }
            }
        }
}
