pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = 'ravneeth123'
        IMAGE_NAME = 'react-app'
        DOCKERHUB_CREDENTIALS_ID = 'ravneeth123'  // Jenkins credential ID
    }

    options {
        skipStagesAfterUnstable()
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${env.BRANCH_NAME}", url: 'https://github.com/ravneet12345/final-project.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh './build.sh'
                }
            }
        }

        stage('Login to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('', ravneeth123) {
                        echo "Logged in to Docker Hub"
                    }
                }
            }
        }

        stage('Tag & Push Image') {
            steps {
                script {
                    def repo = (env.BRANCH_NAME == 'master') ? 'prod' : 'dev'
                    def imageTag = "${ravneeth123}/${repo}:latest"

                    sh "docker tag ${IMAGE_NAME} ${imageTag}"

                    docker.withRegistry('', ravneeth123) {
                        sh "docker push ${imageTag}"
                    }
                }
            }
        }

        stage('Deploy to Server (Optional)') {
            when {
                branch 'master'
            }
            steps {
                echo "Trigger remote deployment or use SSH for production server deployment here."
                // You can add an SSH step or trigger a webhook here.
            }
        }
    }

    post {
        success {
            echo "Build and deployment successful."
        }
        failure {
            echo "Build or deployment failed."
        }
    }
}
