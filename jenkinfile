pipeline {
  agent any

  environment {
    DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds') // Set this in Jenkins credentials
    IMAGE_NAME = "ravneet12345/react-ecommerce"
  }

  triggers {
    githubPush() // Auto-trigger on GitHub push
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'dev', url: 'https://github.com/ravneet12345/devops-build.git'
      }
    }

    stage('Build Docker Image') {
      steps {
        sh 'docker build -t $IMAGE_NAME:dev .'
      }
    }

    stage('Push Docker Image to DockerHub') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'dockerhub-creds', 
          usernameVariable: 'USERNAME', 
          passwordVariable: 'PASSWORD'
        )]) {
          sh '''
            echo "$PASSWORD" | docker login -u "$USERNAME" --password-stdin
            docker push $IMAGE_NAME:dev
          '''
        }
      }
    }

    stage('Deploy (Optional)') {
      steps {
        echo 'Add deployment logic here (e.g., SSH to EC2 and run deploy.sh)'
      }
    }
  }

  post {
    success {
      echo "🎉 Build and push successful!"
    }
    failure {
      echo "❌ Build failed. Please check logs."
    }
  }
}
