pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = 'ravneeth123'
        IMAGE_NAME = 'react-ecommerce-app'
        DOCKERHUB_CREDENTIALS_ID = 'docker'         // Jenkins credential ID for Docker Hub
        GIT_CREDENTIALS_ID = 'github'               // Jenkins credential ID for GitHub
        DEPLOY_SERVER = 'ubuntu@your-server-ip'     // Replace with your actual SSH user@host
        SSH_KEY_ID = 'ssh-key'                      // Jenkins SSH credentials ID
    }

    options {
        skipStagesAfterUnstable()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "*/${env.ACTUAL_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/ravneet12345/devops-build.git',
                        credentialsId: "${GIT_CREDENTIALS_ID}"
                    ]]
                ])
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'chmod +x build.sh'
                    sh './build.sh'
                }
            }
        }

        stage('Login & Push to Docker Hub') {
            steps {
                script {
                    def repoName = (env.BRANCH_NAME == 'prod') ? 'react-app-prod' : 'react-app-dev'
                    def imageTag = "${DOCKERHUB_USERNAME}/${repoName}:latest"

                    sh "docker tag ${IMAGE_NAME} ${imageTag}"
                    docker.withRegistry('', DOCKERHUB_CREDENTIALS_ID) {
                        sh "docker push ${imageTag}"
                    }

                    env.IMAGE_TAG = imageTag // Save for deploy
                }
            }
        }

        stage('Deploy to Server') {
            steps {
                sshagent (credentials: [SSH_KEY_ID]) {
                    script {
                        sh """
                            ssh -o StrictHostKeyChecking=no ${DEPLOY_SERVER} << EOF
                                docker pull ${env.IMAGE_TAG}
                                docker stop ${IMAGE_NAME} || true
                                docker rm ${IMAGE_NAME} || true
                                docker run -d --name ${IMAGE_NAME} -p 80:80 ${env.IMAGE_TAG}
                            EOF
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Build and deployment successful for branch: ${env.BRANCH_NAME}"
        }
        failure {
            echo "❌ Pipeline failed on branch: ${env.BRANCH_NAME}"
        }
    }
}
