pipeline {
    agent any

    environment {
        DOCKERHUB_USERNAME = 'ravneeth123'
        IMAGE_NAME = 'react-app'
        DOCKERHUB_CREDENTIALS_ID = 'docker'  // Jenkins credential ID
        GIT_CREDENTIALS_ID = 'github'
    }
    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Git branch to build')
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    def branch = params.BRANCH_NAME ?: 'main'
                    checkout([$class: 'GitSCM',
                        branches: [[name: "*/${branch}"]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/ravneet12345/final-project.git',
                            credentialsId: "${GIT_CREDENTIALS_ID}"
                        ]]
                    ])
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'chmod +x ./build.sh'
                    sh './build.sh'  // Assumes this script builds a Docker image named react-app
                }
            }
        }

        stage('Login to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('', DOCKERHUB_CREDENTIALS_ID) {
                        echo "Logged into Docker Hub"
                    }
                }
            }
        }

        stage('Tag & Push Image') {
            steps {
                script {
                    def repo = (params.BRANCH_NAME == 'main' || params.BRANCH_NAME == 'master') ? 'react-app-prod' : 'react-app-dev'
                    def imageTag = "${DOCKERHUB_USERNAME}/${repo}:latest"

                    sh "docker tag ${IMAGE_NAME} ${imageTag}"
                    docker.withRegistry('', DOCKERHUB_CREDENTIALS_ID) {
                        sh "docker push ${imageTag}"
                    }
                }
            }
        }

        stage('Trigger Webhook (optional)') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                }
            }
            steps {
                script {
                    def webhookUrl = 'https://your-webhook-url.com/deploy'  // 🔁 Replace with your actual webhook
                    sh """
                        curl -X POST ${webhookUrl} \\
                        -H 'Content-Type: application/json' \\
                        -d '{"status":"success","branch":"${params.BRANCH_NAME}"}'
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }
        failure {
            echo "❌ Pipeline failed."
        }
    }
}
